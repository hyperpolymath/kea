#
# PLAYBOOK.a2ml — Operational playbook
# Runbooks, incident response, deployment procedures.
# Last updated: 2026-03-16

[metadata]
version = "1.0.0"
last-updated = "2026-03-16"

[deployment]
method = "container"
base-image = "cgr.dev/chainguard/rust"
build-tool = "just build-release"
container-file = "Containerfile"

[incident-response]
step-1 = "Check .machine_readable/6a2/STATE.a2ml for current status"
step-2 = "Review recent commits and CI results"
step-3 = "Run `just check` to validate compliance"
step-4 = "Run `panic-attack assail` to scan for security issues"
step-5 = "Check .hypatia/ reports for neurosymbolic findings"

[release-process]
step-1 = "Update version in STATE.a2ml, META.a2ml, Cargo.toml files"
step-2 = "Run `just check` (format, lint, test)"
step-3 = "Run `panic-attack assail` (security scan)"
step-4 = "Tag with v{version} and push"
step-5 = "release.yml workflow auto-builds changelog and GitHub Release"

[maintenance]
schedule = "Weekly dependency updates via Dependabot"
security-scan = "Every push via hypatia-scan, secret-scanner, codeql"
quality-gate = "Every PR via quality.yml, scorecard-enforcer"
