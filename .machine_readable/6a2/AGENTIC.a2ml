#
# AGENTIC.a2ml — AI agent constraints and capabilities
# Defines what AI agents can and cannot do in this repository.
# Last updated: 2026-03-16

[metadata]
version = "1.0.0"
last-updated = "2026-03-16"

[agent-permissions]
can-edit-source = true
can-edit-tests = true
can-edit-docs = true
can-edit-config = true
can-create-files = true
can-edit-workflows = true
can-edit-justfile = true
can-edit-playbooks = true

[agent-constraints]
# What AI agents must NOT do:
# - Never use banned language patterns (believe_me, unsafeCoerce, assert_total, sorry, Admitted, Obj.magic)
# - Never commit secrets or credentials
# - Never use banned languages (TypeScript, Python, Go, Node.js, npm, Bun)
# - Never place state files in repository root (must be in .machine_readable/6a2/)
# - Never relicense an existing file, and never run an automated licence
#   sweep (LICENCE-POLICY.adoc A2). New files get correct SPDX from birth.
# - Never assume a licence. Read standards/LICENCE-POLICY.adoc: Rule 1
#   defaults to MPL-2.0 (code) / CC-BY-SA-4.0 (prose), but Rule 3
#   (co-developed), Rule 4 (network-deployed services) and Rule 5
#   (games) are AGPL-3.0-or-later, and Rule 2 names the PMPL register.
# - Never create .github/ directories in subprojects (all CI/CD at root)
# - Never create .git directories in subprojects (monorepo)
# - Never use Docker/Dockerfile (use Podman/Containerfile)
# - ABI must use Idris2, FFI must use Zig, API must use zig

[agent-workflow]
# Before modifying code:
# 1. Read 0-AI-MANIFEST.a2ml
# 2. Read STATE.a2ml for current status
# 3. Read the relevant subproject README.adoc
# 4. Run `just check` after changes
# 5. Run `panic-attack assail` before committing
