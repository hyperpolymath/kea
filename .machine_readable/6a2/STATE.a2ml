[metadata]
project = "kea"
version = "1.0.0"
last-updated = "2026-04-04"
status = "active"
phase = "CRG compliance and testing"

[project-context]
name = "Kea — Unified Infrastructure Orchestration Toolkit"
description = "Monorepo for intelligent infrastructure orchestration, investigation, signalling, and WASM interfaces"
completion-percentage = 87
target-version = "1.0.0"

[components]
# Component completion tracking (percentage)
bivouac = 100      # Command authority / orchestrator — stable, CRG C certified
call = 100         # Cap'n Proto / MCP signalling — stable
mandible = 80      # Sensor suite — WP-Praxis and Slop-Gate refining
wit = 70           # WIT interface definitions — spec in progress

[components.mandible-crates]
kea-beak = 100     # Filesystem/network auditor — verified, 5 unit tests
kea-mandible = 80  # CLI orchestrator — functional, needs polish
wp-praxis = 80     # WordPress auditor — core audit working, 3 unit tests
slop-gate = 70     # Bloat detection — 5 unit tests, thresholds refining

[testing-status]
bivouac-crg-grade = "C"
bivouac-unit-tests = 22
bivouac-property-tests = 5
bivouac-e2e-tests = 5
bivouac-contract-tests = 11
bivouac-aspect-tests = 10
bivouac-total-tests = 53
bivouac-benchmarks = 5
bivouac-test-coverage = "comprehensive"

[route-to-mvp]
# Ordered by priority — shortest path to functioning system
step-1 = "Slop-Gate heuristic tuning and threshold calibration"
step-2 = "WP-Praxis edge case coverage (multisite, custom themes)"
step-3 = "WIT specification formalisation (Phase 1 from ROADMAP)"
step-4 = "Kea-Mandible CLI polish (help text, output formats)"
step-5 = "End-to-end integration test: Mandible → Call → Bivouac pipeline"
step-6 = "Container image build and publish (Chainguard base)"

[blockers-and-issues]
# No hard blockers — all work is incremental refinement
blocker-1 = "WIT spec depends on Component Model stabilisation (upstream)"
issue-1 = "Slop-Gate thresholds need real-world calibration data"

[critical-next-actions]
action-1 = "Complete Slop-Gate heuristic engine (60% → 90%)"
action-2 = "Formalise WIT interfaces for Mandible ↔ Bivouac communication"
action-3 = "Add ABI layer (Idris2) for cross-component type safety"
action-4 = "Add FFI layer (Zig) for C-compatible sensor plugins"
action-5 = "Publish V-lang API connectors for external integrations"
